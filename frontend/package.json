{
  "name": "sale-sipeed-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "gen:api": "openapi-typescript ../openapi.yaml -o src/schema.d.ts",
    "build": "tsc -b && vite build",
