# 复制为 .env 后按需修改(真实密钥不入库)。
# 服务器部署时 DATABASE_URL 指向服务器上的 PostgreSQL。

SERVER_PORT=8080
DATABASE_URL=postgres://sale_sipeed:sale_sipeed@localhost:5433/sale_sipeed?sslmode=disable
MIGRATIONS_AUTO=true

# ---- 第 3 步 Stripe Checkout ----
# Stripe 沙箱 API Key(sk_test_...,来自沙箱帐号)
STRIPE_API_KEY=
# 站点公网地址(用于拼 success_url / cancel_url 的浏览器回跳)
# 本机前端联调: http://localhost:5173 ;服务器部署: https://your-domain
PUBLIC_BASE_URL=http://localhost:5173

# ---- 第 4 步 Stripe Webhook ----
# webhook 签名密钥(stripe-cli 的 stripe listen 会打印 whsec_...,或后台配置)
STRIPE_WEBHOOK_SECRET=
